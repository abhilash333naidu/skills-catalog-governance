{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "skills-catalog-lifecycle-1",
  "type": "object",
  "required": ["schema", "event_no", "proposal_id", "from", "to", "actor", "command", "created_at_utc"],
  "properties": {
    "schema": {"const": "skill-lifecycle-1"},
    "event_no": {"type": "integer", "minimum": 1},
    "proposal_id": {"type": "string", "minLength": 1},
    "from": {"type": "string", "minLength": 1},
    "to": {"type": "string", "minLength": 1},
    "actor": {"type": "string", "minLength": 1},
    "command": {"type": "string", "minLength": 1},
    "created_at_utc": {"type": "string", "format": "date-time"},
    "input_sha256": {"type": "array", "items": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
    "artifact_paths": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
