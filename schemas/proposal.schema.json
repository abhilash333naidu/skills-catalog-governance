{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "skills-catalog-proposal-1",
  "type": "object",
  "required": ["schema", "proposal_id", "generated_by", "generator_version", "generated_at_utc", "source_session", "source_task", "skill_sha256", "declared_capabilities", "requested_action", "target"],
  "properties": {
    "schema": {"const": "skill-proposal-1"},
    "proposal_id": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "generated_by": {"type": "string", "minLength": 1},
    "generator_version": {"type": "string", "minLength": 1},
    "generated_at_utc": {"type": "string", "format": "date-time"},
    "source_session": {"type": "string", "minLength": 1},
    "source_task": {"type": "string"},
    "skill_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "declared_capabilities": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "requested_action": {"const": "CREATE"},
    "target": {
      "type": "object",
      "required": ["kind", "name", "active_root"],
      "properties": {
        "kind": {"const": "new_skill"},
        "name": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "active_root": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
