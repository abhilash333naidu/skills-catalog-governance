{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "skills-catalog-hermes-capture-1",
  "type": "object",
  "required": ["schema", "hermes_version", "hermes_commit", "source_session", "captured_at_utc"],
  "properties": {
    "schema": {"const": "hermes-capture-1"},
    "hermes_version": {"type": "string", "minLength": 1},
    "hermes_commit": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
    "source_session": {"type": "string", "minLength": 1},
    "source_task": {"type": "string"},
    "captured_at_utc": {"type": "string", "format": "date-time"},
    "write_origin": {"type": "string", "minLength": 1}
  },
  "additionalProperties": true
}
